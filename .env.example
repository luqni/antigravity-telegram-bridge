# ==============================================================================
# Antigravity Telegram Bridge Configuration
# Copy this file to .env and fill in your values:
#   cp .env.example .env
# ==============================================================================

# 1. Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your_bot_token_here

# 2. Allowed Telegram User IDs (whitelisted admins)
#    Separate multiple IDs with commas, e.g.: 123456789,987654321
#    (If you don't know your ID, message the bot and it will display your ID)
ALLOWED_USER_IDS=your_numeric_user_id_here

# 3. Default Working Directory for Antigravity executions
WORKING_DIR=/home/user/projects

# 4. Command Execution Timeout in seconds (default: 300)
TIMEOUT_SECONDS=300

# 5. Safety & Approval Mode (v1.1)
#    - 'strict' (default): Requires explicit inline approval before running CLI actions
#    - 'direct': Immediate execution without confirmation prompt
DEFAULT_SAFETY_MODE=strict

# 6. Approval Timeout for Fail-Secure / Default-Deny in seconds (default: 180s = 3 minutes)
#    If no approval is received within this time, pending execution is cancelled automatically.
APPROVAL_TIMEOUT_SECONDS=180

# 7. [Optional] Custom path to agy binary (auto-detected if empty)
# AGY_PATH=/home/user/.local/bin/agy
AGY_PATH=
